# Atlas configuration
#
# Copy to .env and fill in what you have. EVERY external dependency is
# optional: with none of these set, Atlas runs on SQLite, with a local
# development identity, with manual property data, and with deterministic
# (non-LLM) analysis. Nothing about the financial engine degrades.
#
# Never commit a real .env. Never put a secret in a NEXT_PUBLIC_ variable —
# those are compiled into the browser bundle and are readable by anyone.

# --- Environment ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Leave unset for a local SQLite file. For Supabase, use the pooled connection
# string from Project Settings -> Database.
# ATLAS_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/atlas

# --- Authentication (Supabase) ----------------------------------------------
# Without SUPABASE_JWT_SECRET the API uses a fixed development identity.
# That is refused in production: the API will not start.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SUPABASE_URL=https://your-project.supabase.co

# --- Property data providers ------------------------------------------------
# Optional. Without a key, Atlas uses manually entered data.
# RENTCAST_API_KEY=your-rentcast-key
# ATTOM_API_KEY=your-attom-key

# --- AI ---------------------------------------------------------------------
# "null" (the default) composes analysis deterministically from the engine's
# own numbers, with no language model involved. Set to "anthropic" or "openai"
# to add narration. The AI never performs a calculation either way.
ATLAS_AI_PROVIDER=null
# ATLAS_AI_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Web app ----------------------------------------------------------------
# These ARE exposed to the browser. Only ever put public values here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
